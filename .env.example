# =============================================================================
# qBittorrent Manager - Environment Variables
# =============================================================================

# REQUIRED: qBittorrent API Configuration
QBITTORRENT_HOST=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=admin

# REQUIRED: Path Configuration
# TORRENT_RELATIVE_PATH: The path to the categories that qBittorrent sees (internal in qBit container)
TORRENT_RELATIVE_PATH=/storage
# TORRENT_ABSOLUTE_PATH: The path to the categories that the host machine sees (external)
TORRENT_ABSOLUTE_PATH=/mnt/media

# REQUIRED: Managed Categories
# Only torrents in these categories will be managed by this script
MANAGED_CATEGORIES=movies-radarr,tv-sonarr,seeding

# Skip torrents with hardlinked files (won't save space if deleted)
HARDLINK_CHECK=true

# Minimum days a torrent must seed before it's eligible for deletion
SEEDING_DAYS_REQUIRED=10

# Cron schedule for the manager to run (default: every day at 2 AM)
MANAGER_CRON_SCHEDULE=0 2 * * *

# Log level: debug, info, warn, error
LOG_LEVEL=info

# If set to true, the script will show what would be deleted but won't actually delete anything
DRY_RUN=false
